{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Qahwa": {
    "DocTypePaths": [ "../../samples/doctypes" ],
    "AutoMigrate": false,
    "Auth": {
      "MinPasswordLength": 10,
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15,
      "LoginPermitsPerMinute": 10,
      "SessionHours": 8,
      "SessionCacheSeconds": 15
    }
  }
}
