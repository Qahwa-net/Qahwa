    {
      "kind": "DocType",
      "doctype": "Purchase Order Item",
      "definition": {
        "name": "Purchase Order Item",
        "module": "Employee Operations",
        "isChildTable": true,
        "fields": [
          {
            "name": "product",
            "type": "Link",
            "label": "product",
            "options": "Product",
            "required": true,
            "inListView": true
          },
          {
            "name": "description",
            "type": "Data",
            "label": "description",
            "fetchFrom": "product.product_name"
          },
          {
            "name": "quantity",
            "type": "Decimal",
            "label": "quantity",
            "required": true,
            "default": "1",
            "inListView": true
          },
          {
            "name": "unit_price",
            "type": "Currency",
            "label": "unit price",
            "required": true,
            "fetchFrom": "product.unit_price",
            "fetchIfEmpty": true,
            "inListView": true
          },
          {
            "name": "amount",
            "type": "Currency",
            "label": "amount",
            "formula": "round(quantity * unit_price, 2)",
            "inListView": true
          }
        ],
        "permissions": [],
        "validations": [
          {
            "expression": "quantity > 0",
            "message": "Quantity must be positive"
          },
          {
            "expression": "unit_price >= 0",
            "message": "Price cannot be negative"
          }
        ]
      }
    },
