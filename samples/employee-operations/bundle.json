          {
            "name": "order_title",
            "type": "Data",
            "label": "order title",
            "required": true,
            "inListView": true
          },
          {
            "name": "workflow_state",
            "type": "Select",
            "label": "workflow state",
            "options": "Draft\nPending Approval\nApproved\nOrdered\nReceived\nCancelled",
            "default": "Draft",
            "readOnly": true,
            "inListView": true
          },
          {
            "name": "supplier",
            "type": "Link",
            "label": "supplier",
            "options": "Supplier",
            "required": true,
            "inListView": true
          },
          {
            "name": "requested_by",
            "type": "Link",
            "label": "requested by",
            "options": "User",
            "default": "=user()"
          },
          {
            "name": "order_date",
            "type": "Date",
            "label": "order date",
            "default": "=today()",
            "required": true,
            "inListView": true
          },
          {
            "name": "required_date",
            "type": "Date",
            "label": "required date"
          },
          {
            "name": "currency",
            "type": "Select",
            "label": "currency",
            "options": "SAR\nUSD\nEUR\nAED",
            "default": "SAR",
            "required": true
          },
          {
            "name": "items",
            "type": "Table",
            "label": "items",
            "options": "Purchase Order Item",
            "required": true
          },
          {
            "name": "subtotal",
            "type": "Currency",
            "label": "subtotal",
            "formula": "sum(items, 'amount')"
          },
          {
            "name": "tax_percent",
            "type": "Percent",
            "label": "tax percent",
            "default": "15"
          },
          {
            "name": "tax_amount",
            "type": "Currency",
            "label": "tax amount",
            "formula": "round(subtotal * tax_percent / 100, 2)"
          },
          {
            "name": "grand_total",
            "type": "Currency",
            "label": "grand total",
            "formula": "round(subtotal + tax_amount, 2)",
            "inListView": true
          },
          {
            "name": "notes",
            "type": "Text",
            "label": "notes"
          }
        ],
        "indicators": [
          {
            "value": "Draft",
            "color": "gray"
          },
          {
            "value": "Pending Approval",
            "color": "orange"
          },
          {
            "value": "Approved",
            "color": "green"
          },
          {
            "value": "Ordered",
            "color": "red"
          },
          {
            "value": "Received",
            "color": "gray"
          },
          {
            "value": "Cancelled",
            "color": "orange"
          }
        ],
        "titleField": "order_title",
        "isSubmittable": true,
        "validations": [
          {
            "expression": "count(items) > 0",
            "message": "Add at least one product"
          },
          {
            "expression": "tax_percent >= 0 && tax_percent <= 100",
            "message": "Tax must be between 0 and 100"
          },
          {
            "expression": "empty(required_date) || required_date >= order_date",
            "message": "Required date cannot precede order date"
          }
        ]
      }
